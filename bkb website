<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>WineHub - Wine Delivery</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
}

body {
    background: #f5f5f5;
    color: #222;
}

header {
    background: #8b1538;
    color: white;
    padding: 15px 5%;
    display: flex;
    align-items: center;
    gap: 25px;
    position: sticky;
    top: 0;
    z-index: 100;
}

.logo {
    font-size: 25px;
    font-weight: bold;
}

.search {
    flex: 1;
    display: flex;
}

.search input {
    width: 100%;
    padding: 13px;
    border: none;
    outline: none;
    border-radius: 5px 0 0 5px;
}

.search button {
    padding: 13px 20px;
    border: none;
    background: #f7a600;
    cursor: pointer;
}

.cart-btn {
    background: white;
    color: #8b1538;
    border: none;
    padding: 12px 18px;
    border-radius: 5px;
    cursor: pointer;
    font-weight: bold;
}

.hero {
    background: linear-gradient(
        rgba(70,0,20,.7),
        rgba(70,0,20,.7)
    ),
    url("https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?auto=format&fit=crop&w=1600&q=80");

    background-size: cover;
    background-position: center;
    color: white;
    padding: 100px 5%;
}

.hero h1 {
    font-size: 45px;
    max-width: 650px;
    margin-bottom: 15px;
}

.hero p {
    font-size: 20px;
    margin-bottom: 25px;
}

.hero button {
    background: #f7a600;
    border: none;
    padding: 15px 30px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    border-radius: 5px;
}

.container {
    width: 90%;
    max-width: 1200px;
    margin: 30px auto;
}

.section-title {
    margin-bottom: 20px;
    font-size: 27px;
}

.categories {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 15px;
    margin-bottom: 35px;
}

.category {
    background: white;
    padding: 25px;
    text-align: center;
    border-radius: 8px;
    cursor: pointer;
    box-shadow: 0 2px 7px #ddd;
}

.category:hover {
    transform: translateY(-3px);
}

.category-icon {
    font-size: 40px;
    margin-bottom: 10px;
}

.products {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 20px;
}

.product {
    background: white;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px #ddd;
}

.product img {
    width: 100%;
    height: 220px;
    object-fit: cover;
}

.product-info {
    padding: 15px;
}

.product h3 {
    margin-bottom: 8px;
}

.price {
    color: #8b1538;
    font-size: 20px;
    font-weight: bold;
    margin: 10px 0;
}

.old-price {
    color: #999;
    text-decoration: line-through;
    font-size: 14px;
}

.add {
    width: 100%;
    padding: 12px;
    background: #f7a600;
    border: none;
    cursor: pointer;
    font-weight: bold;
    border-radius: 5px;
}

.add:hover {
    background: #e69500;
}

/* CART */

.cart {
    position: fixed;
    right: -420px;
    top: 0;
    width: 400px;
    max-width: 95%;
    height: 100%;
    background: white;
    z-index: 200;
    padding: 25px;
    box-shadow: -5px 0 15px #aaa;
    transition: .3s;
    overflow-y: auto;
}

.cart.open {
    right: 0;
}

.cart-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20px;
}

.close {
    border: none;
    background: #eee;
    padding: 7px 12px;
    cursor: pointer;
}

.cart-item {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid #ddd;
    padding: 15px 0;
}

.quantity button {
    padding: 3px 8px;
    cursor: pointer;
}

.total {
    margin-top: 20px;
    font-size: 22px;
    font-weight: bold;
}

.checkout {
    width: 100%;
    padding: 15px;
    background: #8b1538;
    color: white;
    border: none;
    margin-top: 20px;
    cursor: pointer;
    border-radius: 5px;
    font-size: 17px;
}

/* CHECKOUT */

.checkout-box {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.65);
    z-index: 300;
    align-items: center;
    justify-content: center;
}

.checkout-content {
    background: white;
    width: 500px;
    max-width: 92%;
    padding: 30px;
    border-radius: 10px;
}

.checkout-content input,
.checkout-content select {
    width: 100%;
    padding: 13px;
    margin: 8px 0 15px;
    border: 1px solid #ccc;
}

.place-order {
    width: 100%;
    padding: 14px;
    background: #8b1538;
    color: white;
    border: none;
    cursor: pointer;
}

footer {
    background: #222;
    color: white;
    padding: 40px 5%;
    margin-top: 50px;
    text-align: center;
}

@media(max-width:900px) {
    .products {
        grid-template-columns: repeat(2,1fr);
    }

    .categories {
        grid-template-columns: repeat(2,1fr);
    }

    header {
        flex-wrap: wrap;
    }

    .search {
        order: 3;
        flex-basis: 100%;
    }
}

@media(max-width:500px) {
    .products {
        grid-template-columns: 1fr;
    }

    .hero h1 {
        font-size: 32px;
    }
}
</style>
</head>

<body>

<header>

    <div class="logo">🍷 WineHub</div>

    <div class="search">
        <input
            id="search"
            placeholder="Search wines, champagne, rosé..."
            oninput="searchProducts()"
        >
        <button>🔍</button>
    </div>

    <button class="cart-btn" onclick="openCart()">
        🛒 Cart (<span id="cartCount">0</span>)
    </button>

</header>


<section class="hero">

    <h1>Premium Wines Delivered To Your Door</h1>

    <p>
        Discover red wine, white wine, rosé and champagne
        at great prices.
    </p>

    <button onclick="scrollToProducts()">
        SHOP NOW
    </button>

</section>


<div class="container">

    <h2 class="section-title">Shop By Category</h2>

    <div class="categories">

        <div class="category" onclick="filterCategory('Red')">
            <div class="category-icon">🍷</div>
            <b>Red Wine</b>
        </div>

        <div class="category" onclick="filterCategory('White')">
            <div class="category-icon">🥂</div>
            <b>White Wine</b>
        </div>

        <div class="category" onclick="filterCategory('Rose')">
            <div class="category-icon">🌹</div>
            <b>Rosé</b>
        </div>

        <div class="category" onclick="filterCategory('Champagne')">
            <div class="category-icon">🍾</div>
            <b>Champagne</b>
        </div>

    </div>


    <h2 class="section-title" id="productsSection">
        Featured Wines
    </h2>

    <div class="products" id="products"></div>

</div>


<!-- CART -->

<div class="cart" id="cart">

    <div class="cart-header">

        <h2>Your Cart</h2>

        <button class="close" onclick="closeCart()">
            ✕
        </button>

    </div>

    <div id="cartItems"></div>

    <div class="total">
        Total:
        UGX <span id="cartTotal">0</span>
    </div>

    <button class="checkout" onclick="showCheckout()">
        CHECKOUT
    </button>

</div>


<!-- CHECKOUT -->

<div class="checkout-box" id="checkoutBox">

    <div class="checkout-content">

        <h2>Complete Your Order</h2>

        <br>

        <label>Full Name</label>
        <input id="customerName" placeholder="Your name">

        <label>Phone Number</label>
        <input id="customerPhone" placeholder="07XXXXXXXX">

        <label>Delivery Address</label>
        <input id="customerAddress" placeholder="Kampala, Uganda">

        <label>Payment Method</label>

        <select id="payment">
            <option>Mobile Money</option>
            <option>Visa / Mastercard</option>
            <option>Cash on Delivery</option>
        </select>

        <button class="place-order" onclick="placeOrder()">
            PLACE ORDER
        </button>

        <br><br>

        <button onclick="closeCheckout()">
            Cancel
        </button>

    </div>

</div>


<footer>

    <h2>🍷 WineHub</h2>

    <br>

    <p>
        Premium wine. Great prices. Fast delivery.
    </p>

    <br>

    <p>
        © 2026 WineHub
    </p>

</footer>


<script>

/* =========================
   PRODUCT DATABASE
========================= */

const products = [

    {
        id: 1,
        name: "Cabernet Sauvignon",
        category: "Red",
        price: 75000,
        oldPrice: 90000,
        image:
        "https://images.unsplash.com/photo-1516594915697-87eb3b1c14ea?auto=format&fit=crop&w=600&q=80"
    },

    {
        id: 2,
        name: "Premium Merlot",
        category: "Red",
        price: 65000,
        oldPrice: 80000,
        image:
        "https://images.unsplash.com/photo-1553361371-9b22f78e8b1d?auto=format&fit=crop&w=600&q=80"
    },

    {
        id: 3,
        name: "Chardonnay",
        category: "White",
        price: 85000,
        oldPrice: 100000,
        image:
        "https://images.unsplash.com/photo-1569529465841-dfecdab7503b?auto=format&fit=crop&w=600&q=80"
    },

    {
        id: 4,
        name: "Classic Rosé",
        category: "Rose",
        price: 55000,
        oldPrice: 70000,
        image:
        "https://images.unsplash.com/photo-1558001373-7b93ee48ffa0?auto=format&fit=crop&w=600&q=80"
    },

    {
        id: 5,
        name: "Luxury Champagne",
        category: "Champagne",
        price: 180000,
        oldPrice: 220000,
        image:
        "https://images.unsplash.com/photo-1598306442928-4d7f9c3c4c3d?auto=format&fit=crop&w=600&q=80"
    },

    {
        id: 6,
        name: "Sweet Red Wine",
        category: "Red",
        price: 60000,
        oldPrice: 75000,
        image:
        "https://images.unsplash.com/photo-1473973266408-ed4e27abdd47?auto=format&fit=crop&w=600&q=80"
    },

    {
        id: 7,
        name: "Sauvignon Blanc",
        category: "White",
        price: 70000,
        oldPrice: 85000,
        image:
        "https://images.unsplash.com/photo-1584916201218-f4242ceb4809?auto=format&fit=crop&w=600&q=80"
    },

    {
        id: 8,
        name: "Pink Rosé",
        category: "Rose",
        price: 60000,
        oldPrice: 75000,
        image:
        "https://images.unsplash.com/photo-1551538827-9c037cb4f32a?auto=format&fit=crop&w=600&q=80"
    }

];


/* =========================
   CART
========================= */

let cart = JSON.parse(
    localStorage.getItem("wineCart")
) || [];


function saveCart() {

    localStorage.setItem(
        "wineCart",
        JSON.stringify(cart)
    );

}


/* =========================
   DISPLAY PRODUCTS
========================= */

function displayProducts(list = products) {

    const container =
        document.getElementById("products");

    container.innerHTML = "";

    list.forEach(product => {

        container.innerHTML += `

        <div class="product">

            <img src="${product.image}">

            <div class="product-info">

                <h3>${product.name}</h3>

                <small>${product.category} Wine</small>

                <div class="price">
                    UGX ${product.price.toLocaleString()}
                </div>

                <div class="old-price">
                    UGX ${product.oldPrice.toLocaleString()}
                </div>

                <br>

                <button
                    class="add"
                    onclick="addToCart(${product.id})"
                >
                    ADD TO CART
                </button>

            </div>

        </div>

        `;

    });

}


/* =========================
   ADD TO CART
========================= */

function addToCart(id) {

    const product =
        products.find(p => p.id === id);

    const existing =
        cart.find(item => item.id === id);

    if(existing) {

        existing.quantity++;

    } else {

        cart.push({
            ...product,
            quantity: 1
        });

    }

    saveCart();

    updateCart();

    alert(product.name + " added to cart!");

}


/* =========================
   CART DISPLAY
========================= */

function updateCart() {

    const container =
        document.getElementById("cartItems");

    container.innerHTML = "";

    let total = 0;
    let count = 0;

    cart.forEach(item => {

        total += item.price * item.quantity;

        count += item.quantity;

        container.innerHTML += `

        <div class="cart-item">

            <div>

                <b>${item.name}</b>

                <br>

                UGX ${item.price.toLocaleString()}

                <br>

                <div class="quantity">

                    <button
                        onclick="changeQuantity(${item.id}, -1)"
                    >
                        -
                    </button>

                    ${item.quantity}

                    <button
                        onclick="changeQuantity(${item.id}, 1)"
                    >
                        +
                    </button>

                </div>

            </div>

            <b>
                UGX ${(item.price * item.quantity)
                .toLocaleString()}
            </b>

        </div>

        `;

    });

    document.getElementById("cartTotal")
        .innerText = total.toLocaleString();

    document.getElementById("cartCount")
        .innerText = count;

}


/* =========================
   QUANTITY
========================= */

function changeQuantity(id, amount) {

    const item =
        cart.find(item => item.id === id);

    if(!item) return;

    item.quantity += amount;

    if(item.quantity <= 0) {

        cart =
            cart.filter(item => item.id !== id);

    }

    saveCart();

    updateCart();

}


/* =========================
   OPEN CART
========================= */

function openCart() {

    document
        .getElementById("cart")
        .classList.add("open");

}


function closeCart() {

    document
        .getElementById("cart")
        .classList.remove("open");

}


/* =========================
   SEARCH
========================= */

function searchProducts() {

    const search =
        document
        .getElementById("search")
        .value
        .toLowerCase();

    const filtered =
        products.filter(product =>
            product.name
            .toLowerCase()
            .includes(search)
        );

    displayProducts(filtered);

}


/* =========================
   CATEGORY
========================= */

function filterCategory(category) {

    const filtered =
        products.filter(
            product =>
            product.category === category
        );

    displayProducts(filtered);

    scrollToProducts();

}


/* =========================
   CHECKOUT
========================= */

function showCheckout() {

    if(cart.length === 0) {

        alert("Your cart is empty.");

        return;

    }

    document
        .getElementById("checkoutBox")
        .style.display = "flex";

}


function closeCheckout() {

    document
        .getElementById("checkoutBox")
        .style.display = "none";

}


/* =========================
   PLACE ORDER
========================= */

function placeOrder() {

    const name =
        document.getElementById("customerName").value;

    const phone =
        document.getElementById("customerPhone").value;

    const address =
        document.getElementById("customerAddress").value;

    const payment =
        document.getElementById("payment").value;

    if(!name || !phone || !address) {

        alert("Please complete all delivery details.");

        return;

    }

    const order = {

        orderNumber:
            "WH-" +
            Math.floor(Math.random() * 1000000),

        customer: name,

        phone: phone,

        address: address,

        payment: payment,

        items: cart,

        total: cart.reduce(
            (sum,item) =>
            sum + item.price * item.quantity,
            0
        ),

        date: new Date().toISOString()

    };


    /*
       SIMPLE BACKEND STORAGE
       In production this would be
       sent to a real server/database.
    */

    const orders =
        JSON.parse(
            localStorage.getItem("orders")
        ) || [];

    orders.push(order);

    localStorage.setItem(
        "orders",
        JSON.stringify(orders)
    );


    alert(
        "Order placed successfully!\\n\\n" +
        "Order Number: " +
        order.orderNumber
    );


    cart = [];

    saveCart();

    updateCart();

    closeCheckout();

    closeCart();

}


/* =========================
   SCROLL
========================= */

function scrollToProducts() {

    document
        .getElementById("productsSection")
        .scrollIntoView({
            behavior: "smooth"
        });

}


/* =========================
   START APP
========================= */

displayProducts();

updateCart();

</script>

</body>
</html>
